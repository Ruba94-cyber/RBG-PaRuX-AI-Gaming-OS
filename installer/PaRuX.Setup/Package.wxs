<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="RBG – PaRuX AI &amp; Gaming OS"
      Manufacturer="RBG"
      Version="$(var.ProductVersion)"
      Language="1033"
      Scope="perMachine"
      UpgradeCode="{F69DACAC-90BA-435D-9990-872ACE68B543}"
      InstallerVersion="500">

    <!-- New releases are full MSI major upgrades: old PaRuX is removed, then the new build is installed.

         AllowSameVersionUpgrades is required, not cosmetic. Every build of a given release carries the
         same three-part ProductVersion (1.8.0) and the same four-part FileVersion (1.8.0.0), so without
         it two things went wrong at once on a rebuild of the same version: FindRelatedProducts did not
         treat the installed product as related, leaving a second "PaRuX" entry registered in Installed
         Apps; and the file-versioning rules skipped every payload file as already current, so the new
         binaries never landed while msiexec still reported success. Users were told they had upgraded
         and were still running the previous build. -->
    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of PaRuX is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- The application itself targets Windows 10+ x64. Extremely old Windows 10 builds are no longer supported.

         The built-in VersionNT property is fed by GetVersionExW, which the OS's application-
         compatibility shim engine can override for a process that lacks a matching compatibility
         GUID in its manifest - observed for real on a genuine Windows 11 (build 26100) machine,
         where VersionNT resolved to 603 (Windows 8.1) instead of 1000 during acceptance testing,
         wrongly refusing "PaRuX requires Windows 10 or newer." CurrentMajorVersionNumber is a
         plain DWORD registry read with no version-query API involved, so it is not subject to the
         same shimming; it did not exist before Windows 10, so its mere presence is the check. -->
    <Property Id="PARUXWIN10ORLATER" Secure="yes">
      <RegistrySearch Id="ParuxWin10OrLaterSearch" Root="HKLM"
                       Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                       Name="CurrentMajorVersionNumber" Type="raw" />
    </Property>
    <Launch Condition="VersionNT64" Message="PaRuX requires 64-bit Windows." />
    <Launch Condition="Installed OR PARUXWIN10ORLATER" Message="PaRuX requires Windows 10 or newer." />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="PaRuX">
        <!-- parux.exe is installed in INSTALLFOLDER\Cli. Append only that folder to the machine
             PATH and let Windows Installer remove exactly its own entry during uninstall. -->
        <Component Id="PaRuXCliPathComponent" Bitness="always64">
          <Environment
              Id="PaRuXCliPath"
              Name="PATH"
              Action="set"
              Part="last"
              Permanent="no"
              System="yes"
              Value="[INSTALLFOLDER]Cli" />
          <RegistryValue
              Root="HKLM"
              Key="Software\Ruba94-cyber\PaRuX"
              Name="CliPathRegistered"
              Type="integer"
              Value="1"
              KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Harvest the complete self-contained Desktop + Core + CLI publish output. Debug symbols are not shipped. -->
    <ComponentGroup Id="PaRuXAppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**">
        <Exclude Files="$(var.PublishDir)\**\*.pdb" />
      </Files>
    </ComponentGroup>

    <Icon Id="PaRuX.ico" SourceFile="$(var.PublishDir)\Assets\parux.ico" />
    <Property Id="ARPPRODUCTICON" Value="PaRuX.ico" />

    <!-- Machine-wide Start Menu entry. The registry key path is removed with the MSI. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="PaRuXProgramMenuFolder" Name="PaRuX">
        <Component Id="PaRuXStartMenuComponent" Bitness="always64">
          <Shortcut
              Id="PaRuXStartMenuShortcut"
              Name="RBG – PaRuX"
              Description="Local-first AI workstation"
              Target="[INSTALLFOLDER]PaRuX.exe"
              WorkingDirectory="INSTALLFOLDER"
              Icon="PaRuX.ico" />
          <RemoveFolder Id="RemovePaRuXProgramMenuFolder" On="uninstall" />
          <!-- ICE38/ICE43/ICE57 require a non-advertised shortcut's KeyPath to be an HKCU
               registry value, matching how Windows Installer tracks per-user Start Menu
               shortcut presence - this is standard MSI/WiX authoring guidance and independent
               of the package's own perMachine Scope, which is what actually drives
               ProgramMenuFolder resolving to the all-users Start Menu at install time. -->
          <RegistryValue
              Root="HKCU"
              Key="Software\Ruba94-cyber\PaRuX"
              Name="InstallDir"
              Type="string"
              Value="[INSTALLFOLDER]"
              KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Normal installer wizard: license, destination folder, install/repair/remove UI. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" ExtendedPathValidation="yes" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <!-- WiX v5+ creates a single default feature and assigns the harvested/component resources.
         Without -NoRedist an explicit "Main" feature (everything above) sits beside two OPTIONAL features that are NOT installed by
         default (Level 2 > INSTALLLEVEL 1): the controller drivers and the Sunshine portable package. -->
    <?if $(IncludeRedist) = 1?>

    <!-- Public, secure properties: the optional-components dialog sets them; a silent install uses them (or ADDLOCAL=...). -->
    <Property Id="PARUX_ADD_DRIVERS" Secure="yes" />
    <Property Id="PARUX_ADD_SUNSHINE" Secure="yes" />

    <DirectoryRef Id="INSTALLFOLDER">
      <Directory Id="REDISTDIR" Name="Redist">
        <Directory Id="REDISTDRIVERSDIR" Name="Drivers" />
        <Directory Id="REDISTSUNSHINEDIR" Name="Sunshine" />
      </Directory>
    </DirectoryRef>

    <ComponentGroup Id="PaRuXMainPayload" Directory="INSTALLFOLDER">
      <ComponentGroupRef Id="PaRuXAppFiles" />
      <ComponentRef Id="PaRuXCliPathComponent" />
      <ComponentRef Id="PaRuXStartMenuComponent" />
    </ComponentGroup>

    <!-- Small, always present with the redist build: the verifying helper and the lock it reads. It acts only on what the
         selected feature carries, and on removal only on what PaRuX itself recorded as installed. -->
    <ComponentGroup Id="PaRuXRedistBase" Directory="REDISTDIR">
      <Files Include="$(var.RedistDir)\Base\**" />
      <!-- The Redist folder (and its two optional sub-folders) can be left behind EMPTY after removal: the post-setup helper and
           the optional-feature steps touch it at run time, so Windows Installer did not create it from a component and would not
           remove it. RemoveFolder On="uninstall" deletes each one if (and only if) it is empty by then; the helper repeats the
           same empty-only cleanup after the setup has ended (Invoke-PaRuXRedist.ps1, Remove-RedistEmptyFolders). -->
      <Component Id="PaRuXRedistFolderCleanup" Bitness="always64">
        <RegistryValue Root="HKLM" Key="Software\Ruba94-cyber\PaRuX\Features" Name="PaRuXRedistFolder" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemovePaRuXRedistDriversDir" Directory="REDISTDRIVERSDIR" On="uninstall" />
        <RemoveFolder Id="RemovePaRuXRedistSunshineDir" Directory="REDISTSUNSHINEDIR" On="uninstall" />
        <RemoveFolder Id="RemovePaRuXRedistDir" Directory="REDISTDIR" On="uninstall" />
      </Component>
    </ComponentGroup>

    <!-- Feature markers (HKLM, written by the feature's own component): a rolled-back or cancelled setup leaves none, so the
         post-setup helper then does nothing. -->
    <ComponentGroup Id="PaRuXControllerDriversPayload" Directory="REDISTDRIVERSDIR">
      <Files Include="$(var.RedistDir)\Drivers\**" />
      <Component Id="PaRuXControllerDriversMarker" Bitness="always64">
        <RegistryValue Root="HKLM" Key="Software\Ruba94-cyber\PaRuX\Features" Name="PaRuXControllerDrivers" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="PaRuXSunshinePayload" Directory="REDISTSUNSHINEDIR">
      <Files Include="$(var.RedistDir)\Sunshine\**" />
      <Component Id="PaRuXSunshineMarker" Bitness="always64">
        <RegistryValue Root="HKLM" Key="Software\Ruba94-cyber\PaRuX\Features" Name="PaRuXSunshine" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="PaRuXMain" Title="PaRuX" Description="The PaRuX application." Level="1" AllowAbsent="no" Display="expand">
      <ComponentGroupRef Id="PaRuXMainPayload" />
      <ComponentGroupRef Id="PaRuXRedistBase" />
    </Feature>

    <Feature Id="PaRuXControllerDrivers" Title="Controller drivers (ViGEmBus + HidHide)"
             Description="Optional, off by default. Installs the vendors' unmodified, signed installers silently, only if the driver is not already on this PC. Needs administrator rights; Windows may ask for a restart."
             Level="2" AllowAbsent="yes" AllowAdvertise="no" Display="expand">
      <Level Value="1" Condition="PARUX_ADD_DRIVERS = &quot;1&quot;" />
      <ComponentGroupRef Id="PaRuXControllerDriversPayload" />
    </Feature>

    <Feature Id="PaRuXSunshine" Title="Sunshine (streaming host)"
             Description="Optional, off by default. Places the official portable Sunshine package (GPL-3.0). PaRuX unpacks it for you only when you ask in Settings; no Windows service, firewall rule or network port is created by this setup."
             Level="2" AllowAbsent="yes" AllowAdvertise="no" Display="expand">
      <Level Value="1" Condition="PARUX_ADD_SUNSHINE = &quot;1&quot;" />
      <ComponentGroupRef Id="PaRuXSunshinePayload" />
    </Feature>

    <!-- Elevated, deferred, only when the drivers feature is selected (install) or PaRuX is fully removed (uninstall, never on a
         major upgrade). The helper is launched in two steps because a vendor installer is an MSI and cannot run inside this
         transaction (error 1618): the step started here only schedules the real work for after this setup ends. A failure never
         fails PaRuX's own setup; it is written to %ProgramData%\PaRuX\logs\redist-install.log. -->
    <CustomAction Id="PaRuXRedistDriversInstall" Directory="REDISTDIR" Execute="deferred" Impersonate="no" Return="ignore"
        ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[REDISTDIR]Invoke-PaRuXRedist.ps1&quot; -Mode Launch -Action Install -RedistRoot &quot;[INSTALLFOLDER]Redist&quot;" />
    <CustomAction Id="PaRuXRedistDriversUninstall" Directory="REDISTDIR" Execute="deferred" Impersonate="no" Return="ignore"
        ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[REDISTDIR]Invoke-PaRuXRedist.ps1&quot; -Mode Launch -Action Uninstall -RedistRoot &quot;[INSTALLFOLDER]Redist&quot;" />

    <InstallExecuteSequence>
      <Custom Action="PaRuXRedistDriversInstall" After="InstallFiles" Condition="&amp;PaRuXControllerDrivers = 3" />
      <Custom Action="PaRuXRedistDriversUninstall" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- One extra wizard page after the install folder: two unchecked boxes. -->
    <UI>
      <Dialog Id="PaRuXOptionalDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Optional components" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="Both are off unless you tick them. You can add them later with Change." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="DriversCheck" Type="CheckBox" X="20" Y="58" Width="330" Height="18" CheckBoxValue="1" Property="PARUX_ADD_DRIVERS" Text="Controller drivers (ViGEmBus + HidHide)" />
        <Control Id="DriversNote" Type="Text" X="36" Y="78" Width="318" Height="42" Transparent="yes" NoPrefix="yes" Text="Runs the drivers' official signed installers silently after this setup, only if they are not already installed. Needs administrator rights (this setup is already elevated). Windows may ask for a restart. ViGEmBus is no longer maintained upstream." />
        <Control Id="SunshineCheck" Type="CheckBox" X="20" Y="126" Width="330" Height="18" CheckBoxValue="1" Property="PARUX_ADD_SUNSHINE" Text="Sunshine (streaming host, GPL-3.0)" />
        <Control Id="SunshineNote" Type="Text" X="36" Y="146" Width="318" Height="42" Transparent="yes" NoPrefix="yes" Text="Adds the official portable package (about 38 MB). Nothing is started: PaRuX unpacks it only when you ask in Settings, and Sunshine opens network ports only while you run it." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
      <Publish Dialog="PaRuXOptionalDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" />
      <Publish Dialog="PaRuXOptionalDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="PaRuXOptionalDlg" Order="5" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="PaRuXOptionalDlg" Order="4" Condition="NOT Installed" />
    </UI>
    <?endif?>
  </Package>
</Wix>
